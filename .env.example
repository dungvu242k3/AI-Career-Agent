# ==============================================================================
# 🚀 CareerPilot AI — Environment Configuration Template
# ==============================================================================

# --- APPLICATION SETTINGS ---
APP_NAME="CareerPilot AI"
DEBUG=false
API_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- AI PROVIDER SELECTION ---
# Primary provider: "openai" (default) or "gemini"
AI_PROVIDER="openai"
ENABLE_FALLBACK=true

# --- OPENAI API CONFIGURATION (PRIMARY) ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_EXTRACTION_MODEL="gpt-4o-mini"
OPENAI_REASONING_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- GOOGLE GEMINI API CONFIGURATION (SECONDARY / FALLBACK) ---
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash-preview-05-20"
GEMINI_FLASH_LITE_MODEL="gemini-2.0-flash"

# --- STORAGE & DATABASE ---
DATABASE_URL="sqlite+aiosqlite:///./data/careerpilot.db"
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=10

# ==============================================================================
# 🚀 CareerPilot AI — Environment Configuration Template
# ==============================================================================

# --- APPLICATION SETTINGS ---
APP_NAME="CareerPilot AI"
APP_ENV="development"
# CAREERPILOT_DEBUG avoids collisions with platform-provided DEBUG values.
CAREERPILOT_DEBUG=false
LOG_FORMAT="json"
OTEL_SERVICE_NAME="careerpilot-backend"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
API_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- DATABASE SETTINGS (POSTGRESQL) ---
# Paste your PostgreSQL connection URL below (Local, Neon, Supabase, AWS RDS)
# Production requires a TLS-enabled URL, for example ?ssl=require.
DATABASE_URL="postgresql+asyncpg://careerpilot:CHANGE_ME@localhost:5432/careerpilot"
# Production: keep false and run `python -m be.db.migrate` as a release step.
DATABASE_AUTO_MIGRATE=false
REDIS_URL="redis://localhost:6379/0"

# --- AI PROVIDER SELECTION ---
# Primary provider: "openai" (default) or "gemini"
AI_PROVIDER="openai"
ENABLE_FALLBACK=true

# --- OPENAI API CONFIGURATION (PRIMARY) ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_EXTRACTION_MODEL="gpt-4o-mini"
OPENAI_REASONING_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
EXTRACTION_TEMPERATURE=0.1
EXTRACTION_MAX_TOKENS=3000
REASONING_TEMPERATURE=0.3
REASONING_MAX_TOKENS=3000
# Optional HMAC secret for future de-identified, owner-scoped response cache.
# CV extraction/generation caching stays disabled.
AI_CACHE_HMAC_SECRET=""
# Per-user daily circuit breakers; tune for the product tier and pricing plan.
AI_DAILY_TOKEN_LIMIT=250000
AI_DAILY_COST_LIMIT_USD=5.00

# --- GOOGLE GEMINI API CONFIGURATION (SECONDARY / FALLBACK) ---
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash-preview-05-20"
GEMINI_FLASH_LITE_MODEL="gemini-2.0-flash"

# --- STORAGE & MINIO OBJECT STORAGE ---
STORAGE_BACKEND="minio"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="CHANGE_ME"
MINIO_SECRET_KEY="CHANGE_ME"
MINIO_BUCKET="careerpilot-cvs"
MINIO_SECURE=false
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=2

# --- AUTHENTICATION (shared by Node.js issuer and FastAPI resource server) ---
# Generate distinct secrets of at least 32 random characters; never commit real values.
JWT_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS"
REFRESH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS"
JWT_ISSUER="careerpilot-auth"
JWT_AUDIENCE="careerpilot-api"

# --- Docker data services (do not use example values for production) ---
POSTGRES_USER="careerpilot"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="careerpilot"
MINIO_ROOT_USER="CHANGE_ME"
MINIO_ROOT_PASSWORD="CHANGE_ME"
# Pin this to an approved release tag or immutable digest before deployment.
MINIO_IMAGE="minio/minio:REPLACE_WITH_PINNED_RELEASE"
